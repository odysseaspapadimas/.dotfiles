{
  "version": 1,
  "idle": {
    "screensaver": 86400,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "odysseas.workspaces"
        },
        {
          "id": "quickshell.spotify",
          "deviceName": "Omarchy Spotify",
          "idleShutdownMinutes": 0,
          "showMiniPlayer": "Off",
          "showVinylRecord": "Off",
          "shortcutPlayer": "Full player",
          "shortcutHints": "Off",
          "showLyrics": "On",
          "showArtwork": "On",
          "showTrackTitle": "On",
          "showArtistName": "Off",
          "showPausedTrack": "On",
          "scrollBarText": "Off",
          "scrollSpeed": "1",
          "maxBarTextWidth": "240",
          "fixedBarWidth": "Off",
          "audioQuality": "320 kbps",
          "clientId": ""
        }
      ],
      "center": [
        {
          "id": "omarchy.clock",
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "birthYear": 0,
          "lifeExpectancy": 90
        },
        {
          "id": "omarchy.weather"
        }
      ],
      "right": [
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "odysseas.wireguard"
        },
        {
          "id": "odysseas.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "odysseas.notifications"
    }
  ],
  "disabledPlugins": [
    "omarchy.notifications"
  ],
  "cloneSourceRestores": [
    "odysseas.notifications"
  ]
}
