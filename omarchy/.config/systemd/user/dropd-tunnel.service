[Unit]
Description=Reverse SSH tunnel for Herdr dropd
Requires=dropd.service
After=dropd.service

[Service]
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -R 8766:127.0.0.1:8766 ubuntu
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
