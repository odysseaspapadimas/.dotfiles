.DS_Store
*~
*.swp
__pycache__/
*.pyc

# Never track dependency installs or generated package trees
**/node_modules/

# Never track Pi credentials, conversations, generated state, or package caches
**/auth.json
**/mcp.json
**/mcp-oauth/
**/sessions/
**/npm/
**/codex-review-reports/
**/web-search.json
**/mcp-cache.json
**/models-store.json
**/skill-toggle.json

# Never track generated Herdr runtime state
herdr/.config/herdr/.plugins.lock
herdr/.config/herdr/*.log
herdr/.config/herdr/session.json
