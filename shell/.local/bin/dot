#!/usr/bin/env bash
set -euo pipefail

repo="$(git -C "$(dirname "$(readlink -f "$0")")" rev-parse --show-toplevel)"
packages=(pi herdr hunk portd nvim ghostty kitty omarchy shell)
stow_only=false

if [[ ${1:-} == "--stow-only" ]]; then
  stow_only=true
  shift
fi

if (($#)); then
  echo "usage: dot [--stow-only]" >&2
  exit 2
fi

install_cli_dependencies() {
  local missing=()
  local command package

  # command:Arch-package:Ubuntu-package:Homebrew-package
  local tools=(
    fish:fish:fish:fish
    starship:starship:starship:starship
    zoxide:zoxide:zoxide:zoxide
    eza:eza:eza:eza
    bat:bat:bat:bat
    fzf:fzf:fzf:fzf
    fd:fd:fd-find:fd
    rg:ripgrep:ripgrep:ripgrep
    nvim:neovim:neovim:neovim
    kitty:kitty:kitty:kitty
    stow:stow:stow:stow
    git:git:git:git
    cargo:rust:cargo:rust
    syncthing:syncthing:syncthing:syncthing
  )

  local manager package_index
  if command -v pacman >/dev/null 2>&1; then
    manager=pacman package_index=1
  elif command -v apt-get >/dev/null 2>&1; then
    manager=apt package_index=2
  elif command -v brew >/dev/null 2>&1; then
    manager=brew package_index=3
  else
    echo "dot: unsupported package manager" >&2
    return 1
  fi

  for tool in "${tools[@]}"; do
    IFS=: read -r command arch_package ubuntu_package brew_package <<<"$tool"
    [[ $command == bat && $(command -v batcat 2>/dev/null) ]] && continue
    [[ $command == fd && $(command -v fdfind 2>/dev/null) ]] && continue
    command -v "$command" >/dev/null 2>&1 && continue
    case $package_index in
      1) package=$arch_package ;;
      2) package=$ubuntu_package ;;
      3) package=$brew_package ;;
    esac
    missing+=("$package")
  done

  if ((${#missing[@]})); then
    echo "dot: installing ${missing[*]}"
    case $manager in
      pacman) sudo pacman -S --needed --noconfirm "${missing[@]}" ;;
      apt)
        sudo apt-get update -qq
        sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing[@]}"
        ;;
      brew) brew install "${missing[@]}" ;;
    esac
  fi

  # Debian and Ubuntu use different binary names for these packages.
  if ! command -v bat >/dev/null 2>&1 && command -v batcat >/dev/null 2>&1; then
    mkdir -p "$HOME/.local/bin"
    ln -sf "$(command -v batcat)" "$HOME/.local/bin/bat"
  fi
  if ! command -v fd >/dev/null 2>&1 && command -v fdfind >/dev/null 2>&1; then
    mkdir -p "$HOME/.local/bin"
    ln -sf "$(command -v fdfind)" "$HOME/.local/bin/fd"
  fi
}

install_rust_tools() {
  local project=$1
  shift
  local manifest="$project/Cargo.toml"
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles-build/$(basename "$project")"
  local binary rebuild=false

  for binary in "$@"; do
    if [[ ! -x "$HOME/.local/bin/$binary" || -L "$HOME/.local/bin/$binary" ]] ||
       find "$project/src" "$manifest" "$project/Cargo.lock" -newer "$HOME/.local/bin/$binary" -print -quit 2>/dev/null | grep -q .; then
      rebuild=true
      break
    fi
  done
  [[ $rebuild == true ]] || return 0

  echo "dot: building $(basename "$project")"
  CARGO_TARGET_DIR="$cache" cargo build --release --locked --manifest-path "$manifest"
  mkdir -p "$HOME/.local/bin"
  for binary in "$@"; do
    rm -f "$HOME/.local/bin/$binary"
    install -m 755 "$cache/release/$binary" "$HOME/.local/bin/$binary"
  done
}

install_dotfile_tools() {
  install_rust_tools "$repo/portd/portd" portd ports
  install_rust_tools "$repo/herdr/project-scratch" project-scratch
  install_rust_tools "$repo/herdr/project-scripts" project-scripts
}

install_personal_tools() {
  if ! command -v herdr >/dev/null 2>&1; then
    echo "dot: installing Herdr"
    curl -fsSL https://herdr.dev/install.sh | sh
  fi

  # Quattro owns the Pi launcher and installs Pi on first use.
  if command -v omarchy >/dev/null 2>&1 && ! command -v pi >/dev/null 2>&1; then
    echo "dot: selecting Pi as the default agent"
    omarchy default agent pi
  fi

  if command -v omarchy >/dev/null 2>&1 && ! command -v something-x >/dev/null 2>&1; then
    echo "dot: installing Something X"
    omarchy pkg aur add something-x
  fi
}

restore_migration_backup() {
  [[ -e "$HOME/.pi/agent/auth.json" ]] && return 0

  local archive candidate answer password
  for candidate in \
    "/run/media/$USER"/*/quattro-migration.tar.zst.enc \
    "/media/$USER"/*/quattro-migration.tar.zst.enc \
    /mnt/*/quattro-migration.tar.zst.enc; do
    [[ -f $candidate ]] && { archive=$candidate; break; }
  done
  [[ -n ${archive:-} ]] || return 0

  printf 'dot: found migration backup at %s\n' "$archive"
  read -rp 'dot: restore SSH, Pi sessions, and personal state? [Y/n] ' answer
  [[ ${answer:-y} =~ ^[Yy]$ ]] || return 0
  read -rsp 'Archive password: ' password
  printf '\n'
  openssl enc -d -aes-256-cbc -pbkdf2 -iter 250000 -in "$archive" -pass fd:3 3<<<"$password" \
    | tar --zstd -xf - -C "$HOME"
  unset password
  chmod 700 "$HOME/.ssh" 2>/dev/null || true
  find "$HOME/.ssh" -type f -exec chmod go-rwx {} + 2>/dev/null || true
  echo "dot: migration state restored"
}

enable_services() {
  command -v systemctl >/dev/null 2>&1 || return 0
  systemctl --user daemon-reload
  systemctl --user enable --now portd.service
  systemctl --user enable --now syncthing.service
}

ensure_fish_login_shell() {
  local fish_path current_shell
  fish_path="$(command -v fish)"
  current_shell="$(getent passwd "$USER" 2>/dev/null | cut -d: -f7 || true)"
  [[ -n $current_shell ]] || current_shell="${SHELL:-}"
  [[ $current_shell == "$fish_path" ]] && return 0

  echo "dot: setting login shell to $fish_path"
  if command -v chsh >/dev/null 2>&1; then
    sudo chsh -s "$fish_path" "$USER"
  else
    echo "dot: chsh is unavailable; set your login shell to $fish_path manually" >&2
  fi
}

if [[ $stow_only == false ]]; then
  if [[ -n $(git -C "$repo" status --porcelain) ]]; then
    echo "dot: $repo has uncommitted changes; commit or stash them first" >&2
    exit 1
  fi
  echo "dot: pulling $repo"
  git -C "$repo" pull --ff-only
  restore_migration_backup
  install_cli_dependencies
  install_personal_tools
  install_dotfile_tools
  ensure_fish_login_shell
fi

available=()
for package in "${packages[@]}"; do
  [[ -d "$repo/$package" ]] && available+=("$package")
done

echo "dot: restowing ${available[*]}"
# Quattro ships its own defaults at many of these paths. Adopt only the files
# represented by our Stow packages, then restore our committed versions through
# the resulting links. Unrelated Quattro configuration remains untouched.
stow --adopt -R -d "$repo" -t "$HOME" "${available[@]}"
git -C "$repo" restore --worktree -- "${available[@]}"
[[ $stow_only == true ]] || enable_services
echo "dot: synchronized"
