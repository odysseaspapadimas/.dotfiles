#!/bin/sh
set -eu

export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
state_dir="${HOME}/.local/state"
stdout_log="${state_dir}/browser-control.log"
stderr_log="${state_dir}/browser-control.error.log"
package_root="$(npm root --global)/@opencode-ai/browser-control"
file="${package_root}/dist/cli.js"

mkdir -p "${state_dir}"

# Browser Control 0.3.2 accepts only its unpublished Store extension ID in
# production builds. Permit the locally installed unpacked extension until the
# Store build is available. Fail closed when upstream code changes.
python3 - "${file}" <<'PY'
import pathlib, sys
p = pathlib.Path(sys.argv[1])
s = p.read_text()
production = 'const allowAnyChromeExtension = browserControlVersion === "0.0.0-dev";'
patched = 'const allowAnyChromeExtension = true; // Local unpacked extension until Store release'
if production in s:
    p.write_text(s.replace(production, patched, 1))
elif patched not in s:
    raise SystemExit("Browser Control unpacked-extension patch no longer applies; inspect the installed release")
PY

exec browser-control serve >>"${stdout_log}" 2>>"${stderr_log}"
