#!/usr/bin/env python3
"""Idempotently add RPIV ask-user blocked-state support to Herdr's Pi integration."""

from pathlib import Path
import os
import sys

path = Path(
    sys.argv[1]
    if len(sys.argv) > 1
    else os.environ.get(
        "HERDR_PI_INTEGRATION",
        Path.home() / ".pi/agent/extensions/herdr-agent-state.ts",
    )
).expanduser()

marker = 'pi.events.on("rpiv:ask-user:blocked"'
anchor = '  pi.events.on("herdr:blocked", (data) => {\n'
bridge = '''  // rpiv-ask-user-question publishes a stable package event; translate it to
  // the generic event consumed by the Herdr integration.
  pi.events.on("rpiv:ask-user:blocked", (data) => {
    pi.events.emit("herdr:blocked", {
      active: data?.active === true,
      label: "Needs input",
    });
  });

'''

if not path.is_file():
    raise SystemExit(f"Herdr Pi integration not found: {path}")

source = path.read_text()
if marker in source:
    print(f"Already patched: {path}")
    raise SystemExit(0)
if source.count(anchor) != 1:
    raise SystemExit(
        f"Unsupported Herdr Pi integration layout: expected one blocked-event anchor in {path}"
    )

path.write_text(source.replace(anchor, bridge + anchor, 1))
print(f"Patched: {path}")
